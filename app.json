{
  "expo": {
    "owner": "lucidcode",
    "name": "Wikit",
    "slug": "wikit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "100",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.lucidcode.wikit"
    },
    "android": {
      "package": "com.lucidcode.wikit",
      "versionCode": 999,
      "permissions": [
        "AD_ID",
        "RECEIVE_BOOT_COMPLETED",
        "READ_INTERNAL_STORAGE"
      ],
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive_icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dcc4190f-3054-4a77-8051-cd18133c0bc8"
      }
    }
  }
}
